# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# Canonical site URL (used for sitemap, robots and social metadata).
NEXT_PUBLIC_SITE_URL=https://www.sacleaninggroup.ca

# Contact form email delivery via Resend (https://resend.com).
# Without a key, submissions are only logged in development and fail in production.
RESEND_API_KEY=
# Inbox that receives contact form messages.
CONTACT_FORM_TO=info@sacleaninggroup.ca
# Sender address. Must be on a domain verified in Resend (e.g. website@sacleaninggroup.ca).
CONTACT_FORM_FROM=SA Cleaning Group <website@sacleaninggroup.ca>
